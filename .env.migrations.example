# Copy to .env.migrations.stage and .env.migrations.prod (both ignored by Git).
# Use APP_ENV="stage" in the stage file, APP_ENV="production" in the prod file.
# Choose the matching Neon branch; branch names cannot be inferred from its hostname.
APP_ENV="stage"
# Direct (NOT -pooler) PostgreSQL URL from that branch's Neon connection dialog.
DIRECT_URL=""
