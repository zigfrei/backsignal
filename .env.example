# Application environment: "stage" locally/staging, "production" in production.
APP_ENV="stage"

# Pooled Neon connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Direct Neon connection used only by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Stable public origin used when generating links and QR codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
