# Application environment: "stage" locally/staging, "production" in production.
# Only the marketing landing page is indexable, and only in "production".
# Auth, dashboard and public feedback forms always use noindex, nofollow.
APP_ENV="stage"

# Pooled Neon connection used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Direct Neon connection used only by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Stable public origin used when generating links and QR codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign and encrypt authentication data.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Optional dedicated secret for short-lived HMAC-IP rate-limit keys.
# If empty, BETTER_AUTH_SECRET is used. Generate with: openssl rand -base64 32
# Use the same value across instances of one environment.
PUBLIC_RATE_LIMIT_SECRET=""

# Transactional email provider.
EMAIL_PROVIDER="resend"

# Authentication email key, with Sending access to auth.backsignal.tech.
# Use a stage key locally/stage and a separate production key. Keep this variable for auth.
RESEND_API_KEY=""

# Separate notifications key, with Sending access to notify.backsignal.tech.
# Create TWO notification keys in Resend: stage (also used locally) and production.
# Configure the matching key in each Vercel project; never fall back to the auth key.
RESEND_NOTIFICATION_API_KEY=""

# Sender used for authentication and security emails.
AUTH_EMAIL_FROM="Backsignal <no-reply@auth.backsignal.tech>"
# Sender used only for feedback notifications. Verify notify.backsignal.tech in Resend.
NOTIFICATION_EMAIL_FROM="Backsignal <notifications@notify.backsignal.tech>"

# Bearer secret for daily notification cron (08:00 UTC) and manual retries.
# Set separately in stage/production Vercel projects. Generate: openssl rand -base64 32
CRON_SECRET=""
# NEXT_PUBLIC_APP_URL above MUST match this instance: local localhost, stage stage.backsignal.tech,
# production backsignal.tech. Queue processing is isolated by this origin even with a shared DB.

# Optional address for replies to authentication emails.
EMAIL_REPLY_TO=""

# Yandex OAuth application credentials used for sign-in and account linking.
# Use one Yandex application for local/stage and a separate one for production.
# Never commit real credentials; configure them locally and in the matching Vercel project.
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""
